[Unit]
Description=Hadar social publishing step for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/flock -n /run/lock/hadar-social-%i.lock /usr/bin/python3 /opt/hadar-gestao/operations/social/worker.py /opt/hadar-gestao/operations/social/config/%i.json
TimeoutStartSec=290
Nice=10

