# Banco e autenticação — use as chaves do ambiente de destino, nunca versione segredos
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# VPS: origem pública confiável usada atrás do proxy HTTPS. Na Vercel pode ficar vazio.
APP_URL=
# Vazio = sem limite; data ISO com fuso explícito para o fim do teste da instância.
INSTANCE_TRIAL_ENDS_AT=

# Publicações orgânicas: não reutilizar os segredos de Meta Ads.
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_FACEBOOK_CONFIG_ID=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_WORKER_SECRET=
SOCIAL_STORAGE_LIMIT_MB=512
# Optional direct VPS storage, capped at 200 MB per video (Supabase stays 50 MB).
SOCIAL_MEDIA_PROVIDER=SUPABASE
SOCIAL_VPS_MEDIA_URL=
SOCIAL_VPS_MEDIA_INSTANCE=
SOCIAL_VPS_MEDIA_SECRET=
SOCIAL_MEDIA_CLEANUP_ENABLED=false
SOCIAL_PUBLISHING_ENABLED=false

# Conta inicial: usada somente pelo comando db:seed, sem senha fixa no código
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Asaas — opcional: pode ser cadastrado pelo administrador em Configurações > Integrações
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=HadarGestao/1.0

# WhatsApp (WAHA roda em um servidor persistente, não dentro da Vercel)
WAHA_API_BASE_URL=https://waha.seudominio.com.br
WAHA_API_KEY=chave_plaintext_enviada_no_header
WAHA_SESSION_NAME=hadar
WAHA_WEBHOOK_TOKEN=gere_um_token_aleatorio_longo

# Assistente Claude — somente no servidor, nunca use NEXT_PUBLIC_ para esta chave
# Opcional: a chave pode ser cadastrada diretamente em Configurações > Integrações
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_WORKSPACE_ID=
# Opcional: segredo estável de pelo menos 32 caracteres para criptografar integrações.
# Sem ele, usa derivação da SUPABASE_SERVICE_ROLE_KEY existente (somente no servidor).
INTEGRATIONS_ENCRYPTION_KEY=
