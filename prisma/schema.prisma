generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum InteractionType {
  COMPLAINT
  PRAISE
  REQUEST
  NOTE
}

enum ServiceType {
  RECURRING
  FREELANCER
}

enum FreelancerServiceType {
  LANDING_PAGE
  GOOGLE_MEU_NEGOCIO
  VIDEO
  FOTO
  OUTRO
}

enum ServiceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CHURN
}

enum PaymentMethod {
  A_VISTA
  PARCELADO
}

enum ReceivableStatus {
  PENDING
  PAID
  OVERDUE
}

enum AsaasBillingType {
  UNDEFINED
  BOLETO
  CREDIT_CARD
  PIX
}

enum FixedExpenseCategory {
  IMPOSTOS
  MARKETING
  SOFTWARES
  EQUIPE
  LOCACAO
  OUTROS
}

enum VariableExpenseCategory {
  ALIMENTACAO
  LOCOMOCAO
  MATERIAL
  OUTROS
}

enum CashEntryType {
  APORTE
  RESERVA_MENSAL
  RETIRADA_DESPESA
}

enum GoalType {
  REVENUE
  NEW_CLIENTS
  RETENTION
  TASKS_ON_TIME
  AVG_NPS
  CUSTOM
}

enum GoalPeriod {
  MONTHLY
  QUARTERLY
}

enum GoalStatus {
  ON_TRACK
  BEHIND
  ACHIEVED
}

enum ClientClassification {
  MRR
  FREELA
}

enum NotificationType {
  MENTION
  TRANSFER
  TASK_UPDATE
}

enum LeadStage {
  NOVO
  FOLLOW_UP
  PROSPECCAO_ATIVA
  REUNIAO_AGENDADA
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(MEMBER)
  permissions Json?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdTasks  Task[]         @relation("TaskCreator")
  assignments   TaskAssignee[]
  interactions  Interaction[]
  weeklyReviews WeeklyReview[]

  weeklyDemandsCreated ClientWeeklyDemand[]
  transfersPerformed   TaskTransferEvent[]  @relation("TransferPerformer")
  chatMessages         ClientChatMessage[]
  chatReads            ClientChatRead[]
  notifications        Notification[]
  uploadedAttachments  TaskAttachment[]
  ownedLeads           Lead[]               @relation("LeadOwner")
  taskUpdates          TaskUpdate[]

  @@map("users")
}

model Client {
  id                 String                @id @default(cuid())
  name               String
  email              String?
  phone              String?
  cpfCnpj            String?
  asaasCustomerId    String?               @unique
  driveLink          String?
  contractLink       String?
  briefing           String?
  status             ClientStatus          @default(ACTIVE)
  contractStartDate  DateTime?
  renewalDate        DateTime?
  brandColors        String[]              @default([])
  brandFontPrimary   String?
  brandFontSecondary String?
  logoUrl            String?
  classification     ClientClassification?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tasks            Task[]
  interactions     Interaction[]
  accesses         Access[]
  services         Service[]
  receivables      Receivable[]
  healthScores     ClientHealthScore[]
  contentCalendars ContentCalendar[]
  weeklyDemands    ClientWeeklyDemand[]
  chatMessages     ClientChatMessage[]
  chatReads        ClientChatRead[]
  projects         Project[]

  @@map("clients")
}

/// Demanda semanal contratada por tipo de entrega, com vigência.
/// Ao alterar a demanda, a linha atual é encerrada (effectiveTo) e uma nova é criada,
/// preservando a avaliação de semanas passadas.
model ClientWeeklyDemand {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveryType  String
  quantity      Int
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([clientId, deliveryType])
  @@map("client_weekly_demands")
}

model Task {
  id            String       @id @default(cuid())
  title         String
  type          String?
  description   String?
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  startDate     DateTime?
  dueDate       DateTime?
  publishDate   DateTime?
  completedAt   DateTime?
  isExtra       Boolean      @default(false)
  area          String?
  projectId     String?
  labelIds      String[]     @default([])
  estimatedTime Float?
  actualTime    Float?
  checklist     Json?
  extraFields   Json?
  tags          String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id])

  assignees      TaskAssignee[]
  calendarItems  ContentCalendarItem[]
  transferEvents TaskTransferEvent[]
  chatMessages   ClientChatMessage[]
  attachments    TaskAttachment[]
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updates        TaskUpdate[]

  @@index([projectId])
  @@map("tasks")
}

/// Área de trabalho com nome editável. O id é o código gravado em `Task.area`
/// (EDICAO, CAPTACAO, DESIGN, OPERACAO), então renomear não mexe nas tarefas.
model TaskArea {
  id        String   @id
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("task_areas")
}

/// Etiqueta personalizável (nome + cor). As tarefas guardam os ids em `Task.labelIds`,
/// então renomear ou trocar a cor reflete em todas de uma vez.
model TaskLabel {
  id        String   @id @default(cuid())
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("task_labels")
}

/// Atualização (comentário) numa tarefa. `mentionedUserIds` guarda quem foi @mencionado
/// e notificado no momento da publicação.
model TaskUpdate {
  id               String   @id @default(cuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content          String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_updates")
}

/// Agrupa tarefas com prazo, status e progresso. `kind` ONBOARDING marca o projeto
/// criado automaticamente para cliente novo (no máximo um por cliente).
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  kind        String    @default("GERAL")
  status      String    @default("EM_ANDAMENTO")
  color       String?
  dueDate     DateTime?
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([kind])
  @@index([clientId])
  @@map("projects")
}

/// Arquivo anexado a uma tarefa. `data` guarda o arquivo como data URL base64,
/// mesma convenção já usada em Client.logoUrl e User.image.
model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

/// Histórico de transferência de responsáveis (quem transferiu, de quem, para quem).
model TaskTransferEvent {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserIds   String[] @default([])
  toUserIds     String[] @default([])
  note          String?
  performedById String
  performedBy   User     @relation("TransferPerformer", fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([taskId])
  @@map("task_transfer_events")
}

/// Chat interno por cliente (equipe autorizada apenas). Mensagens de sistema (isSystem=true)
/// registram eventos automáticos, como transferências de tarefa.
model ClientChatMessage {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id])
  content          String
  isSystem         Boolean  @default(false)
  taskId           String?
  task             Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("client_chat_messages")
}

/// Marca até onde cada usuário já leu o chat de um cliente (para indicar não lidas).
model ClientChatRead {
  clientId   String
  userId     String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([clientId, userId])
  @@map("client_chat_reads")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  taskId    String?
  clientId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

/// Lead comercial no funil de vendas. `value` é o valor negociado (venda quando FECHADO,
/// estimativa antes disso) e alimenta ticket médio e total vendido na dashboard.
/// `stageChangedAt` marca a última mudança de etapa, para medir tempo parado no funil.
model Lead {
  id      String    @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?
  origin  String?
  product String?
  stage   LeadStage @default(NOVO)
  value   Float?
  notes   String?

  lostReason String?

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  stageChangedAt DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage])
  @@index([createdAt])
  @@map("leads")
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@map("task_assignees")
}

model Interaction {
  id      String          @id @default(cuid())
  type    InteractionType
  content String
  date    DateTime        @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@map("interactions")
}

model Service {
  id                String      @id @default(cuid())
  type              ServiceType
  name              String?
  contractMonths    Int?
  monthlyValue      Float?
  startDate         DateTime?
  nextRenewal       DateTime?
  metaAds           Boolean     @default(false)
  googleAds         Boolean     @default(false)
  deliveriesPerWeek Int?
  deliveryTypes     String[]    @default([])

  freelancerType       FreelancerServiceType?
  freelancerTypeCustom String?
  totalValue           Float?
  paymentMethod        PaymentMethod?
  installments         Int?
  status               ServiceStatus          @default(IN_PROGRESS)
  dataPrimeiraParcela  DateTime?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Access {
  id           String  @id @default(cuid())
  platform     String
  url          String?
  email        String?
  password     String?
  observations String?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accesses")
}

model WeeklyReview {
  id             String   @id @default(cuid())
  weekStart      DateTime
  howWasWeek     String
  difficulties   String
  improvements   String
  tasksCompleted Int      @default(0)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@map("weekly_reviews")
}

model Receivable {
  id       String           @id @default(cuid())
  amount   Float
  dueDate  DateTime
  paidDate DateTime?
  status   ReceivableStatus @default(PENDING)
  month    Int
  year     Int

  description       String?
  billingType       AsaasBillingType?
  asaasPaymentId    String?           @unique
  asaasStatus       String?
  asaasInvoiceUrl   String?
  asaasBankSlipUrl  String?
  asaasNetValue     Float?
  asaasSyncedAt     DateTime?
  asaasSyncError    String?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("receivables")
}

model AsaasWebhookEvent {
  id          String   @id
  event       String
  paymentId   String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([paymentId])
  @@map("asaas_webhook_events")
}

model FixedExpense {
  id           String               @id @default(cuid())
  name         String
  category     FixedExpenseCategory
  amount       Float
  paidWithCash Boolean              @default(false)
  month        Int
  year         Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("fixed_expenses")
}

model VariableExpense {
  id           String                  @id @default(cuid())
  name         String
  category     VariableExpenseCategory
  amount       Float
  date         DateTime
  paidWithCash Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("variable_expenses")
}

model Investment {
  id            String        @id @default(cuid())
  description   String
  amount        Float
  paymentMethod PaymentMethod @default(A_VISTA)
  installments  Int?
  date          DateTime
  paidWithCash  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("investments")
}

model CashEntry {
  id          String        @id @default(cuid())
  type        CashEntryType
  amount      Float
  description String?
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@map("cash_entries")
}

model CashConfig {
  id         String   @id @default("singleton")
  minBalance Float    @default(1000)
  updatedAt  DateTime @updatedAt

  @@map("cash_config")
}

model ClientHealthScore {
  id    String @id @default(cuid())
  month Int
  year  Int

  // Churn risk (0-5)
  satisfactionDelivery Float @default(0)
  serviceQuality       Float @default(0)
  deadlineCompliance   Float @default(0)
  perceivedResult      Float @default(0)
  npsScore             Float @default(0)

  // Client quality (0-5)
  respondsTimely   Float @default(0)
  changeVolume     Float @default(0)
  complaints       Float @default(0)
  outOfScope       Float @default(0)
  financiallyWorth Float @default(0)

  observations String?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month, year])
  @@map("client_health_scores")
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  type        GoalType
  targetValue Float
  period      GoalPeriod @default(MONTHLY)
  month       Int
  year        Int
  status      GoalStatus @default(ON_TRACK)
  customValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goals")
}

model ContentCalendar {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekStart        DateTime
  reels            Int      @default(0)
  carroseis        Int      @default(0)
  criativosTrafico Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items ContentCalendarItem[]

  @@map("content_calendars")
}

model ContentCalendarItem {
  id         String          @id @default(cuid())
  calendarId String
  calendar   ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  type       String
  index      Int
  published  Boolean         @default(false)
  taskId     String?
  task       Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("content_calendar_items")
}
